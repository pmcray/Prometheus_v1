[Unit]
Description=Prometheus v1 rclone Drive sync (one shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=governor
Group=governor
ExecStart=/bin/bash /var/lib/prometheus-governor/rclone-sync.sh
Environment=RUN_ID=run-001
Environment=REMOTE=gdrive:prometheus/run-001
Environment=LOCAL=/var/lib/prometheus-governor/drive/run-001

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/prometheus-governor
